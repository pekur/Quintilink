<ui:FluentWindow x:Class="Quintilink.Views.MqttPublishEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="MQTT Publish Editor" SizeToContent="Height" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SaveCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:Card Grid.Row="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,0,0,1">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Name:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Friendly name shown in the MQTT publish list"/>

                <TextBlock Text="Topic:" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                         FontFamily="Consolas"
                         Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="MQTT topic to publish to, e.g. sensors/temperature"/>

                <TextBlock Text="Payload:" Grid.Column="0" Grid.Row="2" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinLines="3" MaxLines="8"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Message payload (sent as UTF-8 text)"/>

                <TextBlock Text="QoS:" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox Width="80" ItemsSource="{Binding QosLevels}" SelectedItem="{Binding Qos}"
                              ToolTip="Quality of Service: 0 = at most once, 1 = at least once, 2 = exactly once"/>
                    <CheckBox Content="Retain" Margin="16,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding Retain}"
                              ToolTip="Ask the broker to retain this message for new subscribers"/>
                </StackPanel>

                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Summary" FontSize="11" Foreground="Gray"/>
                        <TextBlock Text="{Binding PayloadByteCount, StringFormat=Payload bytes: {0}}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ui:Card>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Background="White" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" MinWidth="80" Padding="10,6" Margin="0,0,10,0"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsValid}" />
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,6"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
